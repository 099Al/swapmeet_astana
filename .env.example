# Токен Telegram-бота из BotFather. Без него бот не запустится.
BOT_TOKEN=put-telegram-bot-token-here

# Путь к SQLite-файлу. Можно указать относительный или абсолютный путь.
# Для локального запуска база лежит в ./data.
# В Docker Compose путь переопределяется на /data/swapmeet_astana.sqlite3.
DATABASE_PATH=data/swapmeet_astana.sqlite3

# Чат/канал, куда бот публикует объявления.
PUBLICATION_CHAT_ID=@swapmeet_astana

# ID темы "Общение" в чате объявлений. В Telegram это message_thread_id.
# Сообщения пользователей в чате объявлений разрешены только в этой теме.
COMMUNICATION_TOPIC_ID=

# Сколько сообщений один пользователь может отправить в теме "Общение" за сутки.
COMMUNICATION_DAILY_MESSAGE_LIMIT=20

# Сколько объявлений типа "Купить" один пользователь может создать за сутки.
BUY_DAILY_LIMIT=2

# Общий суточный лимит объявлений для одного пользователя, включая "Купить" и "Продать".
USER_DAILY_AD_LIMIT=10

# Общий лимит объявлений для одного пользователя за последние 60 минут.
USER_HOURLY_AD_LIMIT=5

# Период в днях, за который проверяются повторные фото в объявлениях на продажу.
DUPLICATE_PHOTO_DAYS=7

# Сколько дней объявления показываются в ленте и хранятся до автоматической очистки.
# Расчет идет от начала суток: объявление, созданное в 12:53, считается созданным в 00:00.
RETENTION_PERIOD_DAYS=7

# Telegram user_id главных администраторов через запятую.
# При старте добавляются в таблицу admins с правом добавлять других админов.
ADMIN_IDS=
