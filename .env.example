# Токен Telegram-бота из BotFather. Без него бот не запустится.
BOT_TOKEN=put-telegram-bot-token-here

# Путь к SQLite-файлу. Можно указать относительный или абсолютный путь.
DATABASE_PATH=swapmeet_astana.sqlite3

# Сколько объявлений типа "Купить" один пользователь может создать за сутки.
BUY_DAILY_LIMIT=2

# Общий суточный лимит объявлений для одного пользователя, включая "Купить" и "Продать".
USER_DAILY_AD_LIMIT=10

# Период в днях, за который проверяются повторные фото в объявлениях на продажу.
DUPLICATE_PHOTO_DAYS=7

# Сколько дней объявления показываются в ленте и хранятся до автоматической очистки.
# Расчет идет от начала суток: объявление, созданное в 12:53, считается созданным в 00:00.
RETENTION_PERIOD_DAYS=7
